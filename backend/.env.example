PORT=5000
MONGO_URI=mongodb://localhost:27017/medisiem
# Required — the server refuses to start with this placeholder, a known-weak
# value, or anything under 32 characters. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
# Used to build the link in password-reset emails (routes/auth.js) — point
# this at wherever the React dashboard is actually served from.
FRONTEND_URL=http://localhost:5173

# ─── CAAP live pipeline ─────────────────────────────────────────────────────
# Point these at your Wazuh Indexer (or a bare OpenSearch instance for testing).
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=changeme
WAZUH_INDEXER_INDEX=caap-alerts
WAZUH_INDEXER_VERIFY_SSL=false
CAAP_AI_URL=http://localhost:5001
ALERT_POLL_INTERVAL_MS=5000
ALERT_BUFFER_SIZE=500
