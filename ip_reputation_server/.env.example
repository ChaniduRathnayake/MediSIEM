MEDSHIELD_HOST=0.0.0.0
MEDSHIELD_PORT=8088

MONGO_URI=mongodb://localhost:27017/medshield_ip_reputation
MONGO_DB=medshield_ip_reputation

# Threat intelligence providers — the tab still works without these, enrichment
# just reports as "not configured" instead of returning AbuseIPDB/VirusTotal evidence.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Wazuh Indexer — for the "matching Wazuh alerts" evidence in an investigation.
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=changeme
WAZUH_VERIFY_TLS=false
WAZUH_INDEX_PATTERN=wazuh-alerts-*
WAZUH_INDEXER_URL=https://localhost:9200
