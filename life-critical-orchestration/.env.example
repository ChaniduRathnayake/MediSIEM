# ============================================================
# .env.example  —  copy to .env and fill in real values
# .env is gitignored; never commit real secrets
# ============================================================

# ---------- Decision Engine ----------
ENGINE_HOST=0.0.0.0
ENGINE_PORT=8000
ENGINE_LOG_LEVEL=INFO

# ---------- Audit Log ----------
AUDIT_LOG_PATH=./data/audit_log.jsonl
AUDIT_HASH_ALGO=sha256

# ---------- Shuffle (SOAR) ----------
SHUFFLE_URL=http://localhost:3001
SHUFFLE_API_KEY=replace_me
SHUFFLE_TIER1_PLAYBOOK_ID=
SHUFFLE_TIER2_PLAYBOOK_ID=
SHUFFLE_TIER3_PLAYBOOK_ID=

# ---------- Wazuh (SIEM) ----------
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh
WAZUH_API_PASSWORD=replace_me

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8000
