{
  "$comment": "Single source of truth for CAS (Clinical Alert Score) scoring config. Loaded by ai_server/src/cas_config.py (Python: app.py's live /predict, cas_engine.py's offline research engine) and backend/services/caapService.js (Node: live enrichment + fallback paths). Edit values ONLY here — both runtimes read this file, so a change here is a change everywhere, with no risk of the three implementations silently drifting again. default_weights is the AHP-derived, standards-justified vector documented in CAAP_Weight_Justification.html — do not change it casually; every scenario profile below starts as an identical copy of it and is meant to be tuned per-deployment from Settings -> CAS Weights, not hand-edited here.",

  "default_weights": { "TR": 0.25, "CC": 0.30, "TS": 0.25, "AE": 0.10, "TC": 0.10 },

  "$comment_criticality": "5-tier FDA-device-class hierarchy per MediSIEM_Medical_Device_Criticality_Ranking (21 CFR 860.3 Class III/II/II-I/I/I) — matches device_profiles' own cc scale below exactly (10/8/6/4/2), so a device onboarded through the admin inventory and one resolved by port/protocol land on the same CC for the same real-world criticality. 'elevated' (Tier 3, CC=6) is the FDA Class II/I 'Clinical Data & Informatics Systems' tier — PACS/imaging workstations, EHR/clinical portals, clinical DB servers, LIS, point-of-care analysers: devices that inform care indirectly (data/records) rather than directly monitoring or treating a patient. Was previously folded into 'medium'/'high' before that tier had a name.",
  "criticality_to_cc": { "critical": 10, "high": 8, "elevated": 6, "medium": 4, "low": 2 },

  "cc_lookup_by_device_type": {
    "ICU Ventilator": 10,
    "Infusion Pump": 8,
    "Cardiac Monitor": 8,
    "CT/MRI System": 6,
    "Workstation": 4
  },
  "default_cc": 2,

  "ae_table": {
    "DoS_TCP": 10,
    "ARP_Spoofing": 8,
    "MQTT_Publish_Flood": 8,
    "MQTT_Brute_Force": 8,
    "Replay": 6,
    "Recon": 4,
    "Benign": 0
  },
  "default_ae": 4,

  "$comment_cvss": "CVSS-equivalent baseline, shown alongside CAS in the live dashboard for direct comparison (the whole point being that CVSS is clinically blind and CAS isn't). Same values ai_server/src/hospital_scenarios.py's offline CAAP-vs-CVSS evaluation uses (CVSS_BASE_BY_LABEL) — representative CVSS v3.1 base-score bands per attack technique's general CWE class, not a real per-CVE score, since no CVE field exists anywhere in this dataset.",
  "cvss_base_by_label": {
    "DoS_TCP": 7.5,
    "MQTT_Publish_Flood": 7.5,
    "MQTT_Brute_Force": 8.1,
    "ARP_Spoofing": 6.5,
    "Recon": 3.1,
    "Benign": 0.0
  },
  "default_cvss": 5.0,

