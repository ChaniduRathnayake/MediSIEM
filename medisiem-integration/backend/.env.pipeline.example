# ── Append these to backend/.env ─────────────────────────────────────────────

# Wazuh Indexer (OpenSearch/Elasticsearch REST API — usually port 9200)
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=changeme
# Point at caap-alerts (populated by ml-pipeline/flow_consumer.py with REAL
# RF/IsolationForest/K-Means output) — NOT raw wazuh-alerts-*, which has no
# flow features and would only ever produce a rule.level estimate, not an
# actual ML classification.
WAZUH_INDEXER_INDEX=caap-alerts
WAZUH_INDEXER_VERIFY_SSL=false        # Wazuh's default cert is self-signed; set true once you install a real cert

# CAAP Flask AI server
CAAP_AI_URL=http://localhost:5001

# Live pipeline behaviour
ALERT_POLL_INTERVAL_MS=5000           # how often to check Wazuh for new alerts
ALERT_BUFFER_SIZE=500                 # how many enriched alerts to keep in memory
